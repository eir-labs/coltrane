{
  "slug": "Verdict",
  "primitive": "VERIFY",
  "description": "Pass/fail with evidence",
  "schema": {
    "type": "object",
    "properties": {
      "id":         { "type": "string" },
      "target_ref": { "type": "string" },
      "pass":       { "type": "boolean" },
      "checks":     {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "method":     { "type": "string" },
            "target_ref": { "type": "string" },
            "result":     { "type": "string" }
          },
          "required": ["method"]
        }
      }
    },
    "required": ["id", "target_ref", "pass", "checks"]
  }
}
