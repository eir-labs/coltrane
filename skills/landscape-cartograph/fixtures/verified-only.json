        }
      ]
    },
    "relations": {
      "relations": []
    }
  },
  "assertions": [
    {
      "path": "items.length",
      "op": "equals",
      "value": 1
    },
    {
      "path": "open_findings.length",
      "op": "equals",
      "value": 1
    },
    {
      "path": "uncovered_questions.0",
      "op": "equals",
