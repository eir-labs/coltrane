{
  "id": "verified-only",
  "description": "Only verified items reach the map, and findings are carried",
  "input": {
    "scans": [
      {
        "data": {
          "layer": "x",
          "items": [
            {
              "handle": "a",
              "name": "A",
              "layer": "x",
              "what_it_models": "m",
              "url": "u"
            },
            {
              "handle": "b",
              "name": "B",
              "layer": "x",
              "what_it_models": "m",
              "url": "u"
            }
          ]
        }
      }
    ],
    "verification": {
      "verified_handles": [
        "a"
      ]
    },
    "fit": {
