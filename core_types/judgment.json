{
  "slug": "Judgment",
  "primitive": "JUDGE",
  "description": "Evaluation against criteria",
  "schema": {
    "type": "object",
    "properties": {
      "id":               { "type": "string" },
      "input_refs":       { "type": "array", "items": { "type": "string" } },
      "criteria":         { "type": "array", "minItems": 1 },
      "verdicts":         { "type": "array" },
      "reasoning_chain":  { "type": "array" }
    },
    "required": ["id", "input_refs", "criteria", "verdicts", "reasoning_chain"]
  }
}
