{
  "slug": "triage-verdict",
  "version": 1,
  "extends": "Verdict",
  "domain": "patent-triage",
  "status": "active",
  "schema": {
    "type": "object",
    "properties": {
      "invention_id": {
        "type": "string"
      },
      "recommended": {
        "type": "string",
        "enum": [
          "FILEABLE",
          "REFINE-FIRST",
          "NOT-FILEABLE",
          "INSUFFICIENT-EVIDENCE"
        ]
      },
      "rationale": {
        "type": "string"
      },
      "tests_passed": {
        "type": "array"
      },
      "tests_failed": {
        "type": "array"
      },
      "next_step": {
        "type": "string"
      },
      "caveat": {
        "type": "string"
      },
      "gated": {
        "type": "boolean"
      },
      "gate_reasons": {
        "type": "array"
      },
      "original_recommended": {
        "type": "string"
      },
      "has_patent_coverage": {
        "type": "boolean"
      },
      "survival_count": {
        "type": "number"
      }
    }
  },
  "required_fields": [
    "recommended",
    "rationale"
  ]
}
